# Copia a .env y completa. Nunca subas .env al repositorio.
# IMPORTANTE: ningún programa carga este archivo automáticamente. Define las variables en tu consola
# (PowerShell:  $env:TRADEBOT_KEY = "...")  o en el servicio que ejecute el bot.
# Guarda el .env REAL fuera de carpetas sincronizadas (OneDrive): contiene claves.

# Clave de integridad (>= 32 caracteres). Firma las aprobaciones y la auditoria.
# Generar:  python -c "import secrets; print(secrets.token_urlsafe(48))"
TRADEBOT_KEY=

# DEBUG, INFO, WARNING (por defecto) o ERROR
TRADEBOT_LOG_LEVEL=WARNING

# paper por defecto; pasar a live exige cambiarlo explicitamente (aun no se usa: no hay modulo execution)
TRADING_MODE=paper

# Avisos a Telegram (opcional). Sin esto los avisos van solo a data/alerts.log.
# Crea un bot con @BotFather, escríbele un mensaje y obtén tu chat id. Define ambas SOLO en la consola.
# TRADEBOT_TELEGRAM_TOKEN=
# TRADEBOT_TELEGRAM_CHAT=

# Credenciales de broker/exchange (aun no se usan). Cuando se usen: testnet/paper al inicio,
# sin permiso de retiro y con lista de IPs permitidas.
BROKER_API_KEY=
BROKER_API_SECRET=

# --- Reservado (ADR 0004): PostgreSQL aun no se usa ---
# POSTGRES_PASSWORD=
# DATABASE_URL=postgresql+psycopg://tradebot:...@127.0.0.1:5432/tradebot
